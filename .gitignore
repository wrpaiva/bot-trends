# ===========================================
# 🔐 Segredos — NUNCA commitar
# ===========================================
.env
.env.local
.env.*.local
backend/.env
frontend/.env
credentials.json
token.json
!.env.example
!backend/.env.example
# Override local (ex.: abrir o dashboard para a rede, TIE-62) — escolha de cada máquina
docker-compose.override.yml

# ===========================================
# 🐍 Python
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# Testes / cobertura
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# Type checking / lint
.mypy_cache/
.ruff_cache/
.dmypy.json

# ===========================================
# 📦 Node / Frontend
# ===========================================
node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ===========================================
# 🐳 Infra / dados locais
# ===========================================
.tmp/
*.log
logs/
data/
mongo_data/
redis_data/

# ===========================================
# 💻 Editor / SO
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Backups do Mongo (TIE-35): dados de produção, nunca no git
/backups/*
# A pasta vem no clone com o dono de quem clonou: criada pelo Docker, nasce root
# e o backup falha com permission denied (armadilha 8, TIE-33)
!/backups/.gitkeep

# Rótulos humanos da avaliação do prompt (TIE-26) — dado local, não vai para o git
avaliacao/

# Claude Code: permissões e env locais de cada máquina (as definições em .claude/agents/ são versionadas)
.claude/settings.local.json
