# backend/.env — credenciais e ajustes da aplicação (api, worker, beat).
# MONGO_URI, REDIS_URL, API_KEY e CORS_ORIGINS são sobrescritos pelo
# docker-compose.yml a partir do .env da raiz; os valores daqui só valem fora do Docker.
# Logging: json (padrão, com redação de credenciais) ou text
LOG_LEVEL=INFO
LOG_FORMAT=json

MONGO_URI=mongodb://mongo:27017
MONGO_DB=trends

REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=xxxx
TELEGRAM_CHAT_ID=xxxx
# Chat SEPARADO para alertas de saúde do sistema (coleta/análise parada, LLM em
# fallback, fila acumulando, backup). Sem ele, os problemas só vão para o log.
TELEGRAM_SYSTEM_CHAT_ID=
HEALTH_ALERT_COOLDOWN_HOURS=6
HEALTH_LLM_FALLBACK_MAX=0.5
HEALTH_LLM_MIN_SAMPLE=10
HEALTH_QUEUE_MAX=100
HEALTH_BACKUP_MAX_AGE_HOURS=26
# Alerta quando final_score >= limiar; o mesmo produto só realerta após o
# cooldown, ou antes se a classificação subir de faixa
ALERT_THRESHOLD=60
ALERT_COOLDOWN_HOURS=24

# Mercado Livre
ML_BASE_URL=https://api.mercadolibre.com
ML_SITE_ID=MLB
# Teto de requisições por minuto (0 desliga)
ML_MAX_REQUESTS_PER_MINUTE=60
# OAuth: a API do ML exige token. Crie um app em developers.mercadolivre.com.br,
# cadastre o REDIRECT_URI (https, idêntico ao daqui) e autorize uma vez com
#   docker compose run --rm -it api python -m apps.ml_auth.main
# O token fica no Mongo (collection ml_oauth) e é renovado sozinho.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://localhost/ml/callback
ML_AUTH_URL=https://auth.mercadolivre.com.br/authorization

# Bootstrap de categorias (ver README: "Escolhendo o que coletar")
BOOTSTRAP_FETCH_ML_CATEGORIES=false
BOOTSTRAP_AUTO_ENABLE=false

# TikTok via Apify
APIFY_TOKEN=xxxx
APIFY_ACTOR_ID=clockworks~tiktok-scraper
TIKTOK_HASHTAGS=tiktokmademebuyit,achadinhos,achadosdashopee
# Volume: cada vídeo consome crédito da Apify (vídeos por hashtag / minutos entre coletas)
TIKTOK_RESULTS_PER_HASHTAG=10
TIKTOK_INTERVAL_MIN=120
APIFY_MAX_REQUESTS_PER_MINUTE=30

# Circuit breaker (ML, Apify, LLM): N falhas seguidas abrem o circuito; depois
# de COOLDOWN minutos uma tentativa de teste decide se fecha
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MIN=30

# Pesos do score (default = comportamento histórico). Os 6 numéricos somam 1.0;
# NUMERIC + LLM somam 1.0. Validados na subida.
SCORE_W_RANK=0.20
SCORE_W_REVIEWS=0.15
SCORE_W_SOCIAL=0.25
SCORE_W_VIEWS=0.15
SCORE_W_ENGAGEMENT=0.15
SCORE_W_PRICE_STABILITY=0.10
SCORE_W_NUMERIC=0.6
SCORE_W_LLM=0.4
# percentile: views/engajamento comparados dentro da categoria (nichos aparecem);
# absolute: faixas fixas (categorias de alto volume dominam). Categoria com menos
# que MIN_GROUP produtos usa o pool global do ciclo.
SCORE_NORMALIZATION=percentile
# Motor de tendência: vídeo com mais de N dias sai da análise (não é tendência);
# vídeo com menos de MIN_AGE horas usa esse piso no cálculo de views/h
TREND_MAX_AGE_DAYS=30
TREND_MIN_AGE_HOURS=6
SCORE_PERCENTILE_MIN_GROUP=5
# TIE-18: vídeo do TikTok sem sinal de venda (TikTok Shop, loja no texto, "link na
# bio", preço, código de produto) fica fora da análise. false pontua tudo.
TREND_REQUIRE_COMMERCIAL=true

# LLM (qualquer gateway compatível com a API da OpenAI)
# ATENÇÃO: o nome da variável é LLM_MODEL, não LLM_MODEL_NAME.
# O código lê exatamente estes nomes em src/infrastructure/config.py.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=xxxx
LLM_MODEL=gpt-4.1-mini
# Reaproveita a análise do LLM por N horas quando as métricas do produto não
# mudaram (cache no Redis). 0 desliga.
LLM_CACHE_TTL_HOURS=6
