# Template do nginx do dashboard (TIE-27). O entrypoint da imagem oficial roda
# envsubst em /etc/nginx/templates/*.template na subida do container; com
# NGINX_ENVSUBST_FILTER=^API_KEY$ só ${API_KEY} é trocado — as variáveis do
# próprio nginx ($host, $uri...) passam intactas.
#
# A chave vem do ambiente do container em RUNTIME: não está no bundle, nem na
# imagem, nem no build. O browser só fala com /api desta mesma origem.
server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml;

    # API atrás do proxy. ^~ impede que a regra de assets (regex) pegue /api/*.
    # A barra final do proxy_pass tira o prefixo: /api/rankings → /rankings.
    location ^~ /api/ {
        proxy_pass http://api:8000/;
        # Sobrescreve qualquer X-API-Key que o cliente mande
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Cache para assets estáticos
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check do próprio nginx (não passa pela API)
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }
}
