# ===========================================
# 🔐 Trends Intelligence - Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ===========================================

# =========================================
# 🗄️ MongoDB
# =========================================
MONGO_USER=trends
MONGO_PASSWORD=CHANGE_ME_IN_PRODUCTION
MONGO_DB=trends

# =========================================
# 🔴 Redis
# =========================================
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# =========================================
# 🔐 API Security
# =========================================
# Usada pela API (header X-API-Key). O nginx do dashboard a injeta no proxy
# /api em runtime (TIE-27); ela NÃO vai para o bundle do frontend.
# Gere com: openssl rand -hex 32
API_KEY=CHANGE_ME_GENERATE_RANDOM_STRING
# Vazio: o dashboard usa a mesma origem (proxy /api) e não precisa de CORS.
# Só liste uma origem de browser que chame a API DIRETO. Na porta 80 o browser
# manda "http://localhost", sem o ":80" — com a porta explícita o CORS falha.
CORS_ORIGINS=

# =========================================
# 🔌 Portas no host (só se as padrão já estiverem ocupadas por outro projeto)
# Mongo e Redis são publicados apenas em 127.0.0.1.
# =========================================
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000
# WEB_HOST_PORT=80
# WEB_DEV_HOST_PORT=5173
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3000

# =========================================
# 📈 Observabilidade (profile `observability`, TIE-36)
# =========================================
# Senha do admin do Grafana. Sem ela vale "admin" (o Grafana pede troca no 1º login).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# PROMETHEUS_RETENTION=15d

# =========================================
# 💾 Backup do Mongo (serviço `backup`)
# =========================================
# Diretório do HOST onde os dumps ficam. Para "fora da máquina", aponte para um
# disco externo/NAS montado, ou use BACKUP_UPLOAD_CMD ({} = caminho do arquivo),
# ex.: BACKUP_UPLOAD_CMD=rclone copy {} remoto:trends-backups
# BACKUP_HOST_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14
# BACKUP_KEEP_MIN=3
# BACKUP_UPLOAD_CMD=
# BACKUP_UID=1000
# BACKUP_GID=1000

# =========================================
# 🚀 Produção na VPS (TIE-34) — docs/DEPLOY.md
# =========================================
# Com isto, todo `docker compose ...` na VPS já usa o override de produção.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Domínio público: o Caddy emite e renova o certificado (Let's Encrypt).
# DOMAIN=trends.seudominio.com
# ACME_EMAIL=voce@seudominio.com
# Login do dashboard e do /api. Hash: docker run --rm -it caddy:2.10.0 caddy hash-password
# ENTRE ASPAS SIMPLES — sem elas o compose expande os "$" do hash e o login nunca bate.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH='$2a$14$...'
# Só para testar localmente com 80/443 ocupadas (o redirect HTTP→HTTPS assume a 443).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
