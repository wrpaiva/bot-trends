# ===========================================
# 🔐 Trends Intelligence - Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ===========================================

# =========================================
# 🗄️ MongoDB
# =========================================
MONGO_USER=trends
MONGO_PASSWORD=CHANGE_ME_IN_PRODUCTION
MONGO_DB=trends

# =========================================
# 🔴 Redis
# =========================================
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# =========================================
# 🔐 API Security
# =========================================
# Usada pela API (header X-API-Key) e injetada no build do frontend como
# VITE_API_KEY. Fonte única de propósito: se divergirem, o dashboard toma 401.
# Gere com: openssl rand -hex 32
API_KEY=CHANGE_ME_GENERATE_RANDOM_STRING
# Origens exatas como o browser as envia. Atenção: na porta 80 o browser
# manda "http://localhost", sem o ":80" — com a porta explícita o CORS falha.
# Se mudar WEB_HOST_PORT, a origem correspondente tem que entrar aqui.
CORS_ORIGINS=http://localhost,http://localhost:5173

# =========================================
# 🌐 Frontend
# =========================================
VITE_API_BASE=http://localhost:8000

# =========================================
# 🔌 Portas no host (só se as padrão já estiverem ocupadas por outro projeto)
# Mongo e Redis são publicados apenas em 127.0.0.1.
# =========================================
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000
# WEB_HOST_PORT=80
# WEB_DEV_HOST_PORT=5173
